# GitHub OAuth app credentials (https://github.com/settings/developers)
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Session encryption password (at least 32 characters)
NUXT_SESSION_PASSWORD=

# Comma-separated GitHub numeric user IDs with admin rights (can delist any plugin)
NUXT_ADMIN_GITHUB_IDS=
